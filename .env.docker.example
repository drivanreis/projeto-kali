# ═══════════════════════════════════════════════════════════════
# KALI-CORE V3.0 - Docker Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
# BACKEND (FastAPI/Python)
# ────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=sqlite:////app/data/attack_history.db

# Timezone (IMPORTANTE: Mesmo que no docker-compose.yml)
TZ=America/Fortaleza

# Python behavior
PYTHONUNBUFFERED=1

# FastAPI
ENVIRONMENT=development
DEBUG=True

# ────────────────────────────────────────────────────────────────
# FRONTEND (React/Vite)
# ────────────────────────────────────────────────────────────────

# API Configuration (Deve corresponder ao serviço backend no Docker)
VITE_API_URL=http://localhost:8001

# Vite Dev Server
VITE_HOST=0.0.0.0
VITE_PORT=5190

# Node Environment
NODE_ENV=development

# ────────────────────────────────────────────────────────────────
# DOCKER COMPOSE VARIABLES
# ────────────────────────────────────────────────────────────────

# Compose Project Name (para evitar conflitos)
COMPOSE_PROJECT_NAME=kali-core

# Network Driver
COMPOSE_NETWORK=kali-network
