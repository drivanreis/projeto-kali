FROM python:3.11-slim

# Define diretório de trabalho
WORKDIR /app

# Copia requirements.txt e instala dependências
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia todo o código do backend
COPY . .

# Cria diretório para dados do banco de dados
RUN mkdir -p backend/data

# Expõe porta 5190 internamente
EXPOSE 5190

# Comando para iniciar o backend administrativo
CMD ["python", "main_fastapi.py", "--host", "0.0.0.0", "--port", "5190"]
