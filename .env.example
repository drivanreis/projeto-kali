# KALI-CORE V3.0 - Environment Variables

# ═════════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection string (used in Docker)
DATABASE_URL=postgresql://kali:kali@kali_postgres:5432/kali_core

# SQLite fallback (local development without Docker)
# SQLITE_PATH=backend/data/kali_core.db

# ═════════════════════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode
DEBUG=True

# API configuration
API_HOST=0.0.0.0
API_PORT=8001

# ═════════════════════════════════════════════════════════════════════════════
# FRONTEND CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Vite API configuration
VITE_API_URL=http://localhost:8001
VITE_API_BASE=/api
VITE_API_BASE_URL=http://127.0.0.1:8001
VITE_APP_NAME=KALI-CORE-V3
VITE_APP_VERSION=3.0.0

# Node environment
NODE_ENV=development

# ═════════════════════════════════════════════════════════════════════════════
# SYSTEM CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Timezone
TZ=America/Fortaleza

# Python configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ═════════════════════════════════════════════════════════════════════════════
# SECURITY CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# JWT Secret Key (change in production!)
SECRET_KEY=dev-secret-key-change-in-production

# ═════════════════════════════════════════════════════════════════════════════
# LOGGING CONFIGURATION
# ═════════════════════════════════════════════════════════════════════════════

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ═════════════════════════════════════════════════════════════════════════════
# DATABASE FEATURES
# ═════════════════════════════════════════════════════════════════════════════

# Auto-migrate on startup
AUTO_MIGRATE=False

# Enable API documentation (Swagger)
ENABLE_SWAGGER=True

